{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpLimits": {
    "Upload": {
      "MaxBytes": 10485760
    },
    "RateLimits": {
      "GenerateReport": { "PermitLimit": 20, "WindowSeconds": 60 },
      "DownloadReport": { "PermitLimit": 60, "WindowSeconds": 60 }
    }
  }
}
